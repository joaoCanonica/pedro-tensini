{
  "name": "tensini-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "predev": "pnpm media:prepare",
    "dev": "astro dev",
    "prebuild": "pnpm media:prepare && pnpm validate-config",
    "build": "astro build",
    "postbuild": "pnpm audit-compliance",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check .",
    "test": "pnpm test-config",
    "test-config": "node --test scripts/test-config.mjs",
    "format": "prettier --write .",
    "validate-config": "node scripts/validate-config.mjs",
    "audit-compliance": "node scripts/audit-compliance.mjs",
    "audit-a11y": "node scripts/audit-a11y.mjs",
    "audit-lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit-seo": "node scripts/audit-seo.mjs",
    "audit-contraste": "node scripts/audit-contraste.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:stills": "node scripts/extract-stills.mjs",
    "media:catalogo": "node scripts/prepare-media.mjs --catalogo",
    "capturar": "node scripts/capturar.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
