---
// Status ao vivo: ponto + texto. O texto carrega o significado; o ponto muda de forma
// (cheio = aberto, anel = fechado). Sem JS: o resumo da semana.
import { resumoSemana } from './semana.ts';
---

<p class="status" data-status-vivo>
  <span class="status__ponto" aria-hidden="true"></span>
  <span class="status__texto">{resumoSemana()}</span>
</p>

<script src="./vivo.ts"></script>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-weight: 500;
  }
  .status__ponto {
    width: 0.6em;
    height: 0.6em;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--ponto-fechado);
  }
  .status[data-aberto='true'] .status__ponto {
    background: var(--ponto-aberto);
    border-color: var(--ponto-aberto);
  }
</style>
